# Local-only OpenSpace configuration. Do not add secrets to this file.
OPENSPACE_CLOUD_MODE=off
OPENSPACE_CLOUD_TELEMETRY_MODE=off
OPENSPACE_HOST_SKILL_DIRS=.agents/skills
OPENSPACE_WORKSPACE=.
OPENSPACE_EVOLUTION_EVIDENCE_ENABLED=true
OPENSPACE_EVOLUTION_TRIGGERS_ENABLED=false

# Set at runtime only after choosing an approved local/provider model.
# OPENSPACE_MODEL=
# OPENSPACE_LLM_API_KEY=
# OPENSPACE_LLM_API_BASE=
